# DBserver 主库；复制为根目录 .env 后替换账号和 URL 编码后的密码。
RPA_DATABASE_URI=mysql+pymysql://db-user:url-encoded-password@172.16.50.20:3306/rpa_web

# AI Tools web 找回密码——阿里企业邮箱 SMTP
# 复制为 .env 后填写；不要把包含真实密码的 .env 发给他人或提交到版本库。

PASSWORD_RESET_FRONTEND_URL=http://172.16.50.20:8090
PASSWORD_RESET_SMTP_HOST=smtp.qiye.aliyun.com
PASSWORD_RESET_SMTP_PORT=465
PASSWORD_RESET_SMTP_USERNAME=your-account@your-company.com
PASSWORD_RESET_SMTP_PASSWORD=replace-with-smtp-client-password
PASSWORD_RESET_SMTP_USE_TLS=false
PASSWORD_RESET_SMTP_USE_SSL=true
PASSWORD_RESET_EMAIL_FROM=your-account@your-company.com
PASSWORD_RESET_TOKEN_MAX_AGE_SECONDS=900
